/**
 * AI in Action – Module 5
 * Creates one new Google Form with eight graded questions and seven feedback prompts.
 * RUN MANUALLY in the account that should own the Form.
 * The resulting Form is a draft; review access and publish/share the responder URL.
 * Learner names/email are not requested by the questions; confirm account-level settings.
 */
function createAIInActionQuizAndFeedback() {
  const form = FormApp.create('AI in Action — Knowledge Challenge & Feedback');
  form.setDescription('Learn • Create • Build | A friendly knowledge check and feedback opportunity.');
  form.setIsQuiz(true);
  form.setCollectEmail(false);
  form.setConfirmationMessage('Thank you for learning, exploring and sharing your feedback!');
  form.addSectionHeaderItem().setTitle('Section A — AI Knowledge Challenge');
  const questions = [
  {
    "id": 1,
    "q": "Which is a familiar example of AI in everyday life?",
    "options": [
      "A USB drive storing a document",
      "Video recommendations based on viewing interests",
      "A printer printing a PDF",
      "A keyboard typing a message"
    ],
    "answer": 1,
    "explanation": "Recommendation systems can analyse viewing behaviour and content patterns to suggest relevant videos. The other activities do not inherently require AI."
  },
  {
    "id": 2,
    "q": "Which instruction is most likely to produce a useful AI response?",
    "options": [
      "Explain it.",
      "Write about computers, and make it nice.",
      "Explain computer memory to a beginner with an example and three key points.",
      "Give me everything you know."
    ],
    "answer": 2,
    "explanation": "A clear task, audience, context and expected format help an AI assistant deliver a more relevant answer. Verification is still important."
  },
  {
    "id": 3,
    "q": "What makes Gemini Notebook particularly useful for source-based learning?",
    "options": [
      "It uses supplied sources and links answers to supporting passages.",
      "It guarantees every uploaded document is accurate.",
      "It replaces the need to read original sources.",
      "It checks every claim against the entire internet automatically."
    ],
    "answer": 0,
    "explanation": "Source-grounded Q&A lets learners trace answers to the uploaded material. Source citations support checking but do not guarantee the source itself is correct."
  },
  {
    "id": 4,
    "q": "Why should we verify important answers generated by AI?",
    "options": [
      "AI never provides factual information.",
      "AI responses are always verified automatically.",
      "A confident tone proves a statement is correct.",
      "An AI response can sound convincing while containing errors."
    ],
    "answer": 3,
    "explanation": "Generative AI can produce plausible but inaccurate claims. Check important facts against trustworthy primary or authoritative sources."
  },
  {
    "id": 5,
    "q": "In AI video production, what does image-to-video mean?",
    "options": [
      "Animating a reference image into moving footage",
      "Exporting one still frame from a movie",
      "Shrinking an image file",
      "Converting a photo to a text document"
    ],
    "answer": 0,
    "explanation": "Image-to-video generation uses a still image plus motion instructions to produce moving scenes, often with camera, subject and environmental motion."
  },
  {
    "id": 6,
    "q": "In a product advertisement, what is the main role of voiceover compared with background music?",
    "options": [
      "Voiceover controls camera motion; music controls focus.",
      "They both replace the need for visual storytelling.",
      "Voiceover communicates spoken information; music supports the mood.",
      "Background music automatically verifies product claims."
    ],
    "answer": 2,
    "explanation": "Narration delivers the spoken message, while music shapes atmosphere and emotional pacing. They should be mixed so speech stays understandable."
  },
  {
    "id": 7,
    "q": "What should you do after an AI tool generates a task-planning app?",
    "options": [
      "Share it immediately without using it.",
      "Test key interactions, calculations and data handling.",
      "Remove input validation to make it simpler.",
      "Avoid requesting improvements to the design."
    ],
    "answer": 1,
    "explanation": "Generated software must be tested. Create, edit and complete tasks, check progress calculations, and verify data storage and input validation."
  },
  {
    "id": 8,
    "q": "Which choice best demonstrates responsible AI use?",
    "options": [
      "Sharing passwords to get more personalised answers",
      "Publishing generated claims without checking them",
      "Uploading confidential information to every AI tool",
      "Verifying outputs and protecting private or sensitive information"
    ],
    "answer": 3,
    "explanation": "Responsible use means checking important claims, maintaining privacy, respecting permissions and applying human judgement."
  }
];
  questions.forEach((q, index) => {
    const item = form.addMultipleChoiceItem();
    item.setTitle(`Q${index + 1}. ${q.q}`);
    item.setChoices(q.options.map((choice, i) => item.createChoice(choice, i === q.answer)));
    item.setRequired(true);
    item.setPoints(1);
    const feedback = FormApp.createFeedback().setText(q.explanation).build();
    item.setFeedbackForCorrect(feedback);
    item.setFeedbackForIncorrect(feedback);
  });
  form.addPageBreakItem().setTitle('Section B — Your Voice Matters');
  function addScale(question) {
    form.addScaleItem().setTitle(question).setBounds(1, 5)
      .setLabels('Very low', 'Very high').setRequired(true);
  }
  addScale('How would you rate the overall learning experience?');
  addScale('How relevant were the examples to your studies or work?');
  addScale('How confident do you now feel about trying AI tools yourself?');
  form.addMultipleChoiceItem().setTitle('How was the pace of the session?')
    .setChoiceValues(['Too slow','About right','Too fast']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('Which part was most useful to you?')
    .setChoiceValues(['Discover AI','Learn with AI','Create with AI','Build with AI']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('Which topic would you like to explore next?')
    .setChoiceValues(['AI learning and research','AI video and media','AI application building','Automation','Other']).setRequired(false);
  form.addParagraphTextItem().setTitle('What is one thing we should improve or include next time?').setRequired(false);
  Logger.log('Edit URL (owner only): %s', form.getEditUrl());
  Logger.log('Responder URL (check publication/access): %s', form.getPublishedUrl());
  return form.getId();
}
